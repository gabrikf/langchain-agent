{
  "name": "song-recommender-memory",
  "version": "1.0.0",
  "description": "Song recommender with LangGraph memory persistence using LibSQL",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "chat:erickwendel": "node --experimental-strip-types --env-file .env src/index.ts --user erickwendel",
    "chat:ana": "node --experimental-strip-types --env-file .env src/index.ts --user ana",
    "test": "node --experimental-strip-types --env-file .env --test tests/**/*.test.ts",
    "test:dev": "node --experimental-strip-types --env-file .env --test --watch tests/**/*.test.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli@1.4.6 dev"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "memory",
    "libsql",
    "sqlite",
    "song-recommender",
    "openrouter"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "devDependencies": {
    "@langchain/langgraph-cli": "1.4.6",
    "@types/node": "^26.6.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.28",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/openai": "^1.5.13",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@libsql/client": "^0.18.0",
    "@openrouter/sdk": "^1.2.124",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.3.0",
    "langchain": "^1.5.11",
    "zod": "^4.6.5"
  }
}
