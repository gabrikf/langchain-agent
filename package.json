{
  "name": "faculdade-2022-assistant",
  "version": "1.0.0",
  "description": "Monitor de estudos da faculdade (turma de 2022) com memória via LangGraph, cobrindo Node.js e C#",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "chat": "node --experimental-strip-types --env-file .env src/index.ts",
    "chat:aluno": "node --experimental-strip-types --env-file .env src/index.ts --user aluno-teste",
    "test": "node --experimental-strip-types --env-file .env --test tests/**/*.test.ts",
    "test:dev": "node --experimental-strip-types --env-file .env --test --watch tests/**/*.test.ts",
    "langgraph:serve": "langgraphjs dev"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "memory",
    "libsql",
    "sqlite",
    "faculdade",
    "nodejs",
    "csharp",
    "estudos",
    "openrouter"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "overrides": {
    "better-sqlite3": "^13.0.3"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.30",
    "@huggingface/transformers": "^4.3.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.5.13",
    "@libsql/client": "^0.18.0",
    "@openrouter/sdk": "^1.3.5",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.3.0",
    "langchain": "^1.5.11",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "@openrouter/sdk@1.3.5": true
  }
}
