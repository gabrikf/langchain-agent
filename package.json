{
  "name": "industrial-asset-agent",
  "version": "0.1.0",
  "description": "LangGraph agent base for industrial assets — vibration, temperature and failure prevention",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "db:migrate": "node --experimental-strip-types --env-file .env src/db/migrate.ts",
    "chat": "node --experimental-strip-types --env-file .env src/index.ts",
    "chat:operator": "node --experimental-strip-types --env-file .env src/index.ts --user operator-teste",
    "test": "node --experimental-strip-types --env-file .env --test tests/**/*.test.ts",
    "test:dev": "node --experimental-strip-types --env-file .env --test --watch tests/**/*.test.ts",
    "langgraph:serve": "langgraphjs dev"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "industrial",
    "assets",
    "vibration",
    "temperature",
    "predictive-maintenance",
    "failure-prevention",
    "postgres",
    "openrouter"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.13",
    "@openrouter/sdk": "^1.3.5",
    "knex": "^3.3.0",
    "langchain": "^1.5.11",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@openrouter/sdk@1.3.5": true
  }
}
