# OpenRouter Configuration (for chat/LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Industrial-Asset-Agent
MODEL=arcee-ai/trinity-large-preview:free

# Summarize when conversation context exceeds this many estimated tokens (~chars/4)
MAX_CONTEXT_TOKENS_TO_SUMMARY=32000

# PostgreSQL (preferences, summaries, assets, LangGraph checkpoint)
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/industrial_assets

LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=industrial-asset-agent
